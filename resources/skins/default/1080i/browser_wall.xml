<?xml version="1.0" encoding="UTF-8"?>
<!-- 布局 C：海报墙 + 底部信息条。数据由 resources/lib/browser_window.py 填充 -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0E1116">white.png</texture>
        </control>

        <control type="label">
            <left>96</left>
            <top>36</top>
            <width>1200</width>
            <height>56</height>
            <font>font32_title</font>
            <aligny>center</aligny>
            <textcolor>FFF2B33D</textcolor>
            <label>$INFO[Window.Property(platform)]</label>
        </control>
        <control type="label">
            <left>1224</left>
            <top>36</top>
            <width>600</width>
            <height>56</height>
            <font>font12</font>
            <aligny>center</aligny>
            <align>right</align>
            <textcolor>FF9AA3B2</textcolor>
            <label>$INFO[Window.Property(count)]   [COLOR FFECEEF2]$INFO[Container(50).CurrentItem] / $INFO[Container(50).NumItems][/COLOR]</label>
        </control>

        <!-- 封面网格：7 列 -->
        <control type="panel" id="50">
            <left>96</left>
            <top>112</top>
            <width>1728</width>
            <height>636</height>
            <orientation>vertical</orientation>
            <onleft>noop</onleft>
            <onright>noop</onright>
            <scrolltime tween="quadratic">250</scrolltime>
            <itemlayout width="246" height="318">
                <control type="image">
                    <left>24</left>
                    <top>14</top>
                    <width>198</width>
                    <height>256</height>
                    <texture border="8" colordiffuse="FF171B22">round8.png</texture>
                </control>
                <control type="image">
                    <left>24</left>
                    <top>14</top>
                    <width>198</width>
                    <height>256</height>
                    <aspectratio>keep</aspectratio>
                    <texture diffuse="mask_cover.png">$INFO[ListItem.Art(thumb)]</texture>
                    <visible>!String.IsEqual(ListItem.Property(nocover),true)</visible>
                </control>
                <control type="group">
                    <left>24</left>
                    <top>14</top>
                    <visible>String.IsEqual(ListItem.Property(nocover),true)</visible>
                    <control type="image">
                        <width>198</width>
                        <height>256</height>
                        <texture diffuse="mask_cover.png">$INFO[ListItem.Property(cart_label)]</texture>
                    </control>
                    <control type="image">
                        <width>198</width>
                        <height>256</height>
                        <texture diffuse="mask_cover.png">cover_pattern.png</texture>
                    </control>
                    <control type="textbox">
                        <left>14</left>
                        <top>179</top>
                        <width>170</width>
                        <height>71</height>
                        <font>font10</font>
                        <label>[B]$INFO[ListItem.Label][/B]</label>
                    </control>
                </control>
                <control type="label">
                    <left>24</left>
                    <top>274</top>
                    <width>198</width>
                    <height>34</height>
                    <font>font10</font>
                    <aligny>center</aligny>
                    <align>center</align>
                    <textcolor>FF9AA3B2</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="246" height="318">
                <control type="group">
                    <animation effect="zoom" start="100" end="106" center="123,142" time="150" tween="quadratic">Focus</animation>
                    <control type="image">
                        <left>18</left>
                        <top>8</top>
                        <width>210</width>
                        <height>268</height>
                        <texture border="8" colordiffuse="FFF2B33D">round8.png</texture>
                        <visible>Control.HasFocus(50)</visible>
                    </control>
                    <control type="image">
                        <left>24</left>
                        <top>14</top>
                        <width>198</width>
                        <height>256</height>
                        <texture border="8" colordiffuse="FF171B22">round8.png</texture>
                    </control>
                    <control type="image">
                        <left>24</left>
                        <top>14</top>
                        <width>198</width>
                        <height>256</height>
                        <aspectratio>keep</aspectratio>
                        <texture diffuse="mask_cover.png">$INFO[ListItem.Art(thumb)]</texture>
                        <visible>!String.IsEqual(ListItem.Property(nocover),true)</visible>
                    </control>
                    <control type="group">
                        <left>24</left>
                        <top>14</top>
                        <visible>String.IsEqual(ListItem.Property(nocover),true)</visible>
                        <control type="image">
                            <width>198</width>
                            <height>256</height>
                            <texture diffuse="mask_cover.png">$INFO[ListItem.Property(cart_label)]</texture>
                        </control>
                        <control type="image">
                            <width>198</width>
                            <height>256</height>
                            <texture diffuse="mask_cover.png">cover_pattern.png</texture>
                        </control>
                        <control type="textbox">
                            <left>14</left>
                            <top>179</top>
                            <width>170</width>
                            <height>71</height>
                            <font>font10</font>
                            <label>[B]$INFO[ListItem.Label][/B]</label>
                        </control>
                    </control>
                </control>
                <control type="label">
                    <left>14</left>
                    <top>282</top>
                    <width>218</width>
                    <height>34</height>
                    <font>font10</font>
                    <aligny>center</aligny>
                    <align>center</align>
                    <scroll>true</scroll>
                    <label>[B]$INFO[ListItem.Label][/B]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- 底部信息条 -->
        <control type="group">
            <left>96</left>
            <top>784</top>
            <control type="image">
                <width>1728</width>
                <height>256</height>
                <texture border="16" colordiffuse="FF171B22">round16.png</texture>
            </control>
            <control type="image">
                <left>22</left>
                <top>22</top>
                <width>376</width>
                <height>212</height>
                <texture border="8" colordiffuse="FF000000">round8.png</texture>
            </control>
            <control type="image">
                <left>22</left>
                <top>22</top>
                <width>376</width>
                <height>212</height>
                <aspectratio>keep</aspectratio>
                <texture diffuse="mask_video.png">$INFO[Container(50).ListItem.Art(fanart)]</texture>
                <visible>!Player.HasVideo + !String.IsEqual(Container(50).ListItem.Property(isfolder),true)</visible>
            </control>
            <control type="image">
                <left>110</left>
                <top>28</top>
                <width>200</width>
                <height>200</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Container(50).ListItem.Art(thumb)]</texture>
                <visible>String.IsEqual(Container(50).ListItem.Property(isfolder),true)</visible>
            </control>
            <control type="label">
                <left>22</left>
                <width>376</width>
                <height>256</height>
                <font>font10</font>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FF5C6370</textcolor>
                <label>$ADDON[plugin.video.game-visuals 30340]</label>
                <visible>!Player.HasVideo + String.IsEmpty(Container(50).ListItem.Art(fanart)) + !String.IsEqual(Container(50).ListItem.Property(isfolder),true)</visible>
            </control>
            <control type="videowindow">
                <left>22</left>
                <top>22</top>
                <width>376</width>
                <height>212</height>
                <visible>Player.HasVideo</visible>
            </control>
            <control type="label">
                <left>1300</left>
                <top>208</top>
                <width>400</width>
                <height>30</height>
                <font>font10</font>
                <aligny>center</aligny>
                <align>right</align>
                <textcolor>FFF2B33D</textcolor>
                <label>$ADDON[plugin.video.game-visuals 30337]  $INFO[Player.Time]$INFO[Player.Duration, / ]</label>
                <visible>Player.HasVideo</visible>
            </control>
            <control type="label">
                <left>430</left>
                <top>20</top>
                <width>1270</width>
                <height>56</height>
                <font>font37</font>
                <aligny>center</aligny>
                <label>[B]$INFO[Container(50).ListItem.Label][/B]</label>
            </control>
            <control type="label">
                <left>430</left>
                <top>78</top>
                <width>1270</width>
                <height>36</height>
                <font>font12</font>
                <aligny>center</aligny>
                <textcolor>FFF2B33D</textcolor>
                <label>$INFO[Container(50).ListItem.Property(year)]$INFO[Container(50).ListItem.Property(genre), · ]$INFO[Container(50).ListItem.Property(developer), · ]$INFO[Container(50).ListItem.Property(rating), · ★ ]</label>
            </control>
            <control type="textbox">
                <left>430</left>
                <top>120</top>
                <width>1270</width>
                <height>60</height>
                <font>font12</font>
                <textcolor>FFB4BBC7</textcolor>
                <autoscroll delay="6000" time="3000" repeat="8000">true</autoscroll>
                <label>$INFO[Container(50).ListItem.Property(plot)]</label>
            </control>
            <control type="label">
                <left>430</left>
                <top>208</top>
                <width>1270</width>
                <height>30</height>
                <font>font10</font>
                <aligny>center</aligny>
                <textcolor>FF9AA3B2</textcolor>
                <label>$ADDON[plugin.video.game-visuals 30339]</label>
            </control>
        </control>
    </controls>
</window>
