<?xml version="1.0" encoding="UTF-8"?>
<!-- 平台展示：分类货架。数据由 resources/lib/platform_window.py 填充 -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0E1116">white.png</texture>
        </control>

        <!-- 顶栏 -->
        <control type="label">
            <left>96</left>
            <top>44</top>
            <width>260</width>
            <height>52</height>
            <font>font30_title</font>
            <aligny>center</aligny>
            <textcolor>FFF2B33D</textcolor>
            <label>[B]GAME VISUALS[/B]</label>
        </control>
        <control type="label">
            <left>376</left>
            <top>44</top>
            <width>800</width>
            <height>52</height>
            <font>font12</font>
            <aligny>center</aligny>
            <textcolor>FF9AA1AD</textcolor>
            <label>$INFO[Window.Property(root)]</label>
        </control>
        <control type="label">
            <left>1124</left>
            <top>44</top>
            <width>700</width>
            <height>52</height>
            <font>font12</font>
            <align>right</align>
            <aligny>center</aligny>
            <textcolor>FF9AA1AD</textcolor>
            <label>$INFO[Window.Property(total)]</label>
        </control>

        <!-- 左侧：选中平台的信息 -->
        <control type="group">
            <left>96</left>
            <top>152</top>
            <control type="image">
                <width>520</width>
                <height>120</height>
                <aspectratio align="left" aligny="center">keep</aspectratio>
                <fadetime>150</fadetime>
                <texture>$INFO[Container(50).ListItem.Art(thumb)]</texture>
            </control>
            <control type="label">
                <top>140</top>
                <width>760</width>
                <height>84</height>
                <font>font60</font>
                <aligny>center</aligny>
                <textcolor>FFFFFFFF</textcolor>
                <label>[B]$INFO[Container(50).ListItem.Label][/B]</label>
            </control>
            <control type="grouplist">
                <top>240</top>
                <width>760</width>
                <height>44</height>
                <orientation>horizontal</orientation>
                <itemgap>12</itemgap>
                <usecontrolcoords>true</usecontrolcoords>
                <control type="button">
                    <width>auto</width>
                    <height>44</height>
                    <font>font10</font>
                    <textoffsetx>20</textoffsetx>
                    <aligny>center</aligny>
                    <enable>false</enable>
                    <disabledcolor>FF14110A</disabledcolor>
                    <texturenofocus border="20" colordiffuse="FFF2B33D">pill.png</texturenofocus>
                    <texturefocus border="20" colordiffuse="FFF2B33D">pill.png</texturefocus>
                    <label>[B]$INFO[Container(50).ListItem.Property(count)][/B]</label>
                </control>
                <control type="button">
                    <width>auto</width>
                    <height>44</height>
                    <font>font10</font>
                    <textoffsetx>20</textoffsetx>
                    <aligny>center</aligny>
                    <enable>false</enable>
                    <disabledcolor>FFE8EAEE</disabledcolor>
                    <texturenofocus border="20" colordiffuse="FF2A303B">pill.png</texturenofocus>
                    <texturefocus border="20" colordiffuse="FF2A303B">pill.png</texturefocus>
                    <label>$INFO[Container(50).ListItem.Property(category)]</label>
                </control>
                <control type="button">
                    <width>auto</width>
                    <height>44</height>
                    <font>font10</font>
                    <textoffsetx>20</textoffsetx>
                    <aligny>center</aligny>
                    <enable>false</enable>
                    <disabledcolor>FFE8EAEE</disabledcolor>
                    <texturenofocus border="20" colordiffuse="FF2A303B">pill.png</texturenofocus>
                    <texturefocus border="20" colordiffuse="FF2A303B">pill.png</texturefocus>
                    <label>$ADDON[plugin.video.game-visuals 30347]</label>
                    <visible>String.IsEqual(Container(50).ListItem.Property(video),true)</visible>
                </control>
            </control>
            <control type="textbox">
                <top>308</top>
                <width>740</width>
                <height>140</height>
                <font>font27</font>
                <textcolor>FFC3C8D0</textcolor>
                <autoscroll delay="6000" time="3000" repeat="8000">true</autoscroll>
                <label>$INFO[Container(50).ListItem.Property(plot)]</label>
            </control>
            <control type="label">
                <top>462</top>
                <width>760</width>
                <height>36</height>
                <font>font10</font>
                <aligny>center</aligny>
                <textcolor>FF7D8491</textcolor>
                <label>$ADDON[plugin.video.game-visuals 30348]</label>
            </control>
        </control>

        <!-- 右侧：平台内随机游戏的截图 / 预览视频 -->
        <control type="group">
            <left>944</left>
            <top>152</top>
            <control type="image">
                <left>-24</left>
                <top>-24</top>
                <width>928</width>
                <height>543</height>
                <texture border="40">shadow.png</texture>
            </control>
            <control type="image">
                <width>880</width>
                <height>495</height>
                <texture border="16" colordiffuse="FF000000">round16.png</texture>
            </control>
            <control type="group">
                <visible>!Player.HasVideo + String.IsEmpty(Container(50).ListItem.Art(fanart))</visible>
                <control type="image">
                    <width>880</width>
                    <height>495</height>
                    <texture border="16" colordiffuse="FF171B22">round16.png</texture>
                </control>
                <control type="image">
                    <width>880</width>
                    <height>495</height>
                    <texture colordiffuse="40FFFFFF">scanlines.png</texture>
                </control>
                <control type="image">
                    <left>260</left>
                    <top>150</top>
                    <width>360</width>
                    <height>140</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="2EFFFFFF">$INFO[Container(50).ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <top>310</top>
                    <width>880</width>
                    <height>40</height>
                    <font>font10</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FF7D8491</textcolor>
                    <label>$ADDON[plugin.video.game-visuals 30349]</label>
                </control>
            </control>
            <control type="image">
                <width>880</width>
                <height>495</height>
                <aspectratio>keep</aspectratio>
                <fadetime>300</fadetime>
                <texture>$INFO[Container(50).ListItem.Art(fanart)]</texture>
                <visible>!Player.HasVideo</visible>
            </control>
            <control type="videowindow">
                <width>880</width>
                <height>495</height>
                <visible>Player.HasVideo</visible>
            </control>
        </control>

        <!-- 分类 -->
        <control type="list" id="60">
            <left>96</left>
            <top>704</top>
            <width>1200</width>
            <height>56</height>
            <orientation>horizontal</orientation>
            <ondown>50</ondown>
            <onup>noop</onup>
            <onleft>noop</onleft>
            <onright>noop</onright>
            <scrolltime tween="quadratic">150</scrolltime>
            <itemlayout width="190" height="56">
                <control type="label">
                    <width>182</width>
                    <height>56</height>
                    <font>font12</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FF9AA1AD</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="190" height="56">
                <control type="image">
                    <width>182</width>
                    <height>56</height>
                    <texture border="20" colordiffuse="FFF2B33D">pill.png</texture>
                </control>
                <control type="image">
                    <left>-4</left>
                    <top>-4</top>
                    <width>190</width>
                    <height>64</height>
                    <texture border="20" colordiffuse="80FFFFFF">pill.png</texture>
                    <visible>Control.HasFocus(60)</visible>
                </control>
                <control type="image">
                    <width>182</width>
                    <height>56</height>
                    <texture border="20" colordiffuse="FFF2B33D">pill.png</texture>
                    <visible>Control.HasFocus(60)</visible>
                </control>
                <control type="label">
                    <width>182</width>
                    <height>56</height>
                    <font>font12</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FF14110A</textcolor>
                    <label>[B]$INFO[ListItem.Label][/B]</label>
                </control>
            </focusedlayout>
        </control>

