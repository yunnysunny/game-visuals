<?xml version="1.0" encoding="UTF-8"?>
<!-- 布局 A：经典双栏。数据由 resources/lib/browser_window.py 填充 -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0E1116">white.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <aspectratio>scale</aspectratio>
            <fadetime>300</fadetime>
            <texture colordiffuse="22FFFFFF">$INFO[Container(50).ListItem.Art(fanart)]</texture>
        </control>

        <!-- 顶栏 -->
        <control type="label">
            <left>72</left>
            <top>40</top>
            <width>1200</width>
            <height>60</height>
            <font>font36_title</font>
            <textcolor>FFF2B33D</textcolor>
            <label>$INFO[Window.Property(platform)]</label>
        </control>
        <control type="label">
            <left>1128</left>
            <top>40</top>
            <width>420</width>
            <height>60</height>
            <font>font12</font>
            <align>right</align>
            <textcolor>FF9AA3B2</textcolor>
            <label>$INFO[Window.Property(count)]</label>
        </control>
        <control type="label">
            <left>1568</left>
            <top>40</top>
            <width>280</width>
            <height>60</height>
            <font>font32_title</font>
            <align>right</align>
            <label>$INFO[System.Time]</label>
        </control>

        <!-- 左栏：游戏列表 -->
        <control type="list" id="50">
            <left>72</left>
            <top>140</top>
            <width>600</width>
            <height>868</height>
            <onleft>noop</onleft>
            <onright>noop</onright>
            <scrolltime tween="quadratic">200</scrolltime>
            <itemlayout height="70">
                <control type="image">
                    <left>16</left>
                    <top>13</top>
                    <width>33</width>
                    <height>44</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>66</left>
                    <top>0</top>
                    <width>520</width>
                    <height>70</height>
                    <font>font13</font>
                    <textcolor>FFC9CED8</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout height="70">
                <control type="image">
                    <width>600</width>
                    <height>66</height>
                    <texture colordiffuse="FFF2B33D">white.png</texture>
                    <visible>Control.HasFocus(50)</visible>
                </control>
                <control type="image">
                    <left>16</left>
                    <top>11</top>
                    <width>33</width>
                    <height>44</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>66</left>
                    <top>0</top>
                    <width>520</width>
                    <height>66</height>
                    <font>font13</font>
                    <textcolor>FF1A1206</textcolor>
                    <scroll>true</scroll>
                    <label>[B]$INFO[ListItem.Label][/B]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- 右栏：预告片 / 截图 -->
        <control type="group">
            <left>728</left>
            <top>140</top>
            <control type="image">
                <width>1120</width>
                <height>540</height>
                <texture colordiffuse="FF000000">white.png</texture>
            </control>
            <control type="image">
                <width>1120</width>
                <height>540</height>
                <aspectratio>keep</aspectratio>
                <fadetime>200</fadetime>
                <texture>$INFO[Container(50).ListItem.Art(fanart)]</texture>
                <visible>!Player.HasVideo + !String.IsEqual(Container(50).ListItem.Property(isfolder),true)</visible>
            </control>
            <control type="image">
                <left>360</left>
                <top>70</top>
                <width>400</width>
                <height>400</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Container(50).ListItem.Art(thumb)]</texture>
                <visible>String.IsEqual(Container(50).ListItem.Property(isfolder),true)</visible>
            </control>
            <control type="videowindow">
                <width>1120</width>
                <height>540</height>
                <visible>Player.HasVideo</visible>
            </control>
            <control type="image">
                <top>484</top>
                <width>1120</width>
                <height>56</height>
                <texture colordiffuse="C0000000">white.png</texture>
                <visible>Player.HasVideo | !String.IsEmpty(Container(50).ListItem.Property(trailer))</visible>
            </control>
            <control type="label">
                <left>24</left>
                <top>484</top>
                <width>1072</width>
                <height>56</height>
                <font>font12</font>
                <label>$ADDON[plugin.video.game-visuals 30337]  $INFO[Player.Time]$INFO[Player.Duration, / ]</label>
                <visible>Player.HasVideo</visible>
            </control>
            <control type="label">
                <left>24</left>
                <top>484</top>
                <width>1072</width>
                <height>56</height>
                <font>font12</font>
                <textcolor>FF9AA3B2</textcolor>
                <label>$ADDON[plugin.video.game-visuals 30338]</label>
                <visible>!Player.HasVideo + !String.IsEmpty(Container(50).ListItem.Property(trailer))</visible>
            </control>
        </control>

        <!-- 右栏：封面 + 信息 -->
        <control type="image">
            <left>728</left>
            <top>708</top>
            <width>210</width>
            <height>280</height>
            <aspectratio aligny="top">keep</aspectratio>
            <texture>$INFO[Container(50).ListItem.Art(thumb)]</texture>
            <visible>!String.IsEqual(Container(50).ListItem.Property(isfolder),true)</visible>
        </control>
        <control type="group">
            <left>970</left>
            <top>700</top>
            <control type="label">
                <width>878</width>
                <height>56</height>
                <font>font37</font>
                <label>[B]$INFO[Container(50).ListItem.Label][/B]</label>
            </control>
            <control type="label">
                <top>58</top>
                <width>878</width>
                <height>36</height>
                <font>font12</font>
                <textcolor>FFF2B33D</textcolor>
                <label>$INFO[Container(50).ListItem.Property(year)]$INFO[Container(50).ListItem.Property(genre), · ]$INFO[Container(50).ListItem.Property(developer), · ]$INFO[Container(50).ListItem.Property(players), · ,P]$INFO[Container(50).ListItem.Property(rating), · ★ ]</label>
            </control>
            <control type="textbox">
                <top>104</top>
                <width>878</width>
                <height>140</height>
                <font>font12</font>
                <textcolor>FFB4BBC7</textcolor>
                <autoscroll delay="6000" time="3000" repeat="8000">true</autoscroll>
                <label>$INFO[Container(50).ListItem.Property(plot)]</label>
            </control>
            <control type="label">
                <top>262</top>
                <width>878</width>
                <height>30</height>
                <font>font10</font>
                <textcolor>FF9AA3B2</textcolor>
                <label>$ADDON[plugin.video.game-visuals 30339]</label>
            </control>
        </control>
    </controls>
</window>
